# Copy to .env (never commit the real one). Backend reads these from the environment.
TRACEON_SECRET=change-me-to-a-long-random-string
# Optional: path overrides
# TRACEON_DATA_DIR=./data
# TRACEON_MODEL=./ml/artifacts/tile_patchcore.pt
# Optional hosted LLM to re-phrase grounded answers. Leave empty to use the built-in grounded template mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

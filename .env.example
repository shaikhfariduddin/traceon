# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tile_quality_db
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# JWT Security
SECRET_KEY=replace_with_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paths
UPLOAD_DIR=./uploads
DATASET_PATH=./dataset
MODEL_PATH=./model_artifacts/tile_defect_classifier.pt

# Google Gemini API Key
# Optional: leave empty to use the deterministic fallback
GEMINI_API_KEY=
